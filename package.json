  "type": "module",
  "scripts": {
    "blocks:watch": "wp-scripts start --source-path=editor/blocks/src --output-path=editor/blocks/dist",
    "blocks:hot": "wp-scripts start --source-path=editor/blocks/src --output-path=editor/blocks/dist --hot",
    "blocks:build": "wp-scripts build --source-path=editor/blocks/src --output-path=editor/blocks/dist",
    "scripts:watch": "wp-scripts start --source-path=editor/scripts/src --output-path=editor/scripts/dist",
    "scripts:build": "wp-scripts build --source-path=editor/scripts/src --output-path=editor/scripts/dist",
    "build": "npm run blocks:build && npm run scripts:build"
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.2.0"
  },
  "dependencies": {
    "react-select": "^5.10.2"
  }
