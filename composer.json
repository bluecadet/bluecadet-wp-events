{
    "name": "bluecadet/bluecadet-events",
    "autoload": {
        "psr-4": {
            "BluecadetEvents\\": "BluecadetEvents/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BluecadetEvents\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Shaun M Baer",
            "email": "shaun@bluecadet.com"
        }
    ],
    "require": {
        "rlanvin/php-rrule": "^2.6",
        "deliciousbrains/wp-background-processing": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.4",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "docs": [ "@docs:api", "@docs:hooks", "@docs:landing" ],
        "docs:api": "docker run --rm -v \"$PWD\":/data phpdoc/phpdoc:3 run -c phpdoc.dist.xml",
        "docs:hooks": "php bin/docs/generate-hooks.php .docs-build/hooks/index.html",
        "docs:landing": "@php -r \"@mkdir('.docs-build',0755,true); copy('docs/index.html','.docs-build/index.html');\"",
        "docs:serve": "php -S localhost:8080 -t .docs-build"
    },
    "type": "wordpress-plugin",
    "version": "0.1.0"
}
